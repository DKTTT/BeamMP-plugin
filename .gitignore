# ===========================================
# .gitignore - BeamMP BMPLogin project
# ===========================================

# --- 运行时数据 (含密码 hash / HWID / 玩家 IP, 绝不提交) ---
bmp_login/
*.json.tmp
*.lock

# --- 打包产物 (太大, 用 Release 发布) ---
dist/
build/
*.spec
*.exe
*.zip

# --- Python 缓存 ---
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# --- 临时调试文件 ---
_server_plugin_b64.txt
_server_plugin_noadmin.lua
_*.py
_*.log
_*.err
_t.py
final_fix.py
final_literal_fix.py
final_regex_fix.py
fix_encoding_and_autologin.py
fix_pass2.py
recover_and_fix.py
recover_v2.py
实例代码/

# --- BeamNG / BeamMP 运行日志 + 服务器配置 (含 AuthKey, 绝不提交) ---
beamng.log
consoleHistory.json
Server.log
Server-*.log
Server.old.log
ServerConfig.toml

# --- 操作系统垃圾 ---
Thumbs.db
desktop.ini
.DS_Store

# --- IDE ---
.vs/
.vscode/
.idea/
*.swp
*~
